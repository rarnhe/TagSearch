{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-msvc",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl",
        "BUILD_TESTING": true
      }
    },
    {"name": "x86", "hidden": true, "inherits": "windows-msvc", "architecture": {"value": "x86", "strategy": "external"}},
    {"name": "x64", "hidden": true, "inherits": "windows-msvc", "architecture": {"value": "x64", "strategy": "external"}},
    {"name": "x86-debug", "displayName": "x86 Debug", "inherits": "x86", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}},
    {"name": "x86-release", "displayName": "x86 Release", "inherits": "x86", "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}},
    {"name": "x64-debug", "displayName": "x64 Debug", "inherits": "x64", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}},
    {"name": "x64-release", "displayName": "x64 Release", "inherits": "x64", "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}}
  ],
  "buildPresets": [
    {"name": "x86-debug", "configurePreset": "x86-debug"},
    {"name": "x86-release", "configurePreset": "x86-release"},
    {"name": "x64-debug", "configurePreset": "x64-debug"},
    {"name": "x64-release", "configurePreset": "x64-release"}
  ],
  "testPresets": [
    {
      "name": "windows-tests",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {"name": "x86-debug", "inherits": "windows-tests", "configurePreset": "x86-debug"},
    {"name": "x86-release", "inherits": "windows-tests", "configurePreset": "x86-release"},
    {"name": "x64-debug", "inherits": "windows-tests", "configurePreset": "x64-debug"},
    {"name": "x64-release", "inherits": "windows-tests", "configurePreset": "x64-release"}
  ]
}
